{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pipeline.local/schemas/evenement.schema.json",
  "title": "Événement",
  "description": "Schéma d'entité 'evenement' dérivé de l'ontologie V5.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evenement_[a-z0-9_]+$",
      "description": "Identifiant interne stable (préfixe 'evenement_')."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom affiché (peut contenir accents/langue du jeu)."
    },
    "status": {
      "type": "string",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "description": "Statut de l'information."
    },
    "source": {
      "type": "string",
      "description": "Fichier/section d'origine."
    },
    "justification": {
      "type": "string",
      "description": "Pourquoi cet élément existe."
    },
    "trigger": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timing": {
      "type": "object"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "missable": {
      "type": "boolean"
    },
    "repeatable": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "display_name",
    "status",
    "trigger",
    "effects"
  ],
  "additionalProperties": true,
  "x_schema_version": "5.0.0"
}
