{
  "$id": "https://pipeline.local/schemas/saison.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Schéma d'entité 'saison' dérivé de l'ontologie V5.",
  "properties": {
    "display_name": {
      "description": "Nom affiché (peut contenir accents/langue du jeu).",
      "minLength": 1,
      "type": "string"
    },
    "growable": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Identifiant interne stable (préfixe 'saison_').",
      "pattern": "^saison_[a-z0-9_]+$",
      "type": "string"
    },
    "justification": {
      "description": "Pourquoi cet élément existe.",
      "type": "string"
    },
    "length_days": {
      "minimum": 1,
      "type": "integer"
    },
    "order": {
      "minimum": 1,
      "type": "integer"
    },
    "source": {
      "description": "Fichier/section d'origine.",
      "type": "string"
    },
    "status": {
      "description": "Statut de l'information.",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "type": "string"
    },
    "weather_pool": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "display_name",
    "status",
    "order"
  ],
  "title": "Saison",
  "type": "object",
  "x_schema_version": "5.0.0"
}
