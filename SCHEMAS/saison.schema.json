{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pipeline.local/schemas/saison.schema.json",
  "title": "Saison",
  "description": "Schéma d'entité 'saison' dérivé de l'ontologie V5.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^saison_[a-z0-9_]+$",
      "description": "Identifiant interne stable (préfixe 'saison_')."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom affiché (peut contenir accents/langue du jeu)."
    },
    "status": {
      "type": "string",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "description": "Statut de l'information."
    },
    "source": {
      "type": "string",
      "description": "Fichier/section d'origine."
    },
    "justification": {
      "type": "string",
      "description": "Pourquoi cet élément existe."
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "length_days": {
      "type": "integer",
      "minimum": 1
    },
    "weather_pool": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "growable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "display_name",
    "status",
    "order"
  ],
  "additionalProperties": true,
  "x_schema_version": "5.0.0"
}
