{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pipeline.local/schemas/ressource.schema.json",
  "title": "Ressource",
  "description": "Schéma d'entité 'ressource' dérivé de l'ontologie V5.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ressource_[a-z0-9_]+$",
      "description": "Identifiant interne stable (préfixe 'ressource_')."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom affiché (peut contenir accents/langue du jeu)."
    },
    "status": {
      "type": "string",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "description": "Statut de l'information."
    },
    "source": {
      "type": "string",
      "description": "Fichier/section d'origine."
    },
    "justification": {
      "type": "string",
      "description": "Pourquoi cet élément existe."
    },
    "category": {
      "type": "string"
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seasonal": {
      "type": "boolean"
    },
    "base_value": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "display_name",
    "status",
    "category"
  ],
  "additionalProperties": true,
  "x_schema_version": "5.0.0"
}
