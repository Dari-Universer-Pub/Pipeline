{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pipeline.local/schemas/machine.schema.json",
  "title": "Machine / station",
  "description": "Schéma d'entité 'machine' dérivé de l'ontologie V5.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^machine_[a-z0-9_]+$",
      "description": "Identifiant interne stable (préfixe 'machine_')."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom affiché (peut contenir accents/langue du jeu)."
    },
    "status": {
      "type": "string",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "description": "Statut de l'information."
    },
    "source": {
      "type": "string",
      "description": "Fichier/section d'origine."
    },
    "justification": {
      "type": "string",
      "description": "Pourquoi cet élément existe."
    },
    "function": {
      "type": "string"
    },
    "built_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "PNJ/artisan (canon: Marin)."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipe_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placement_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "animation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "display_name",
    "status",
    "function"
  ],
  "additionalProperties": true,
  "x_schema_version": "5.0.0"
}
