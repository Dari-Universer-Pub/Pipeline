{
  "$id": "https://pipeline.local/schemas/quete.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Schéma d'entité 'quete' dérivé de l'ontologie V5.",
  "properties": {
    "choices": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "consequences": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "discovery": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "description": "Nom affiché (peut contenir accents/langue du jeu).",
      "minLength": 1,
      "type": "string"
    },
    "effects": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "failure_conditions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "fallback": {
      "type": [
        "string",
        "null"
      ]
    },
    "giver_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Identifiant interne stable (préfixe 'quete_').",
      "pattern": "^quete_[a-z0-9_]+$",
      "type": "string"
    },
    "justification": {
      "description": "Pourquoi cet élément existe.",
      "type": "string"
    },
    "location_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "missable": {
      "type": "boolean"
    },
    "participants": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "preconditions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "description": "Fichier/section d'origine.",
      "type": "string"
    },
    "status": {
      "description": "Statut de l'information.",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "type": "string"
    },
    "steps": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "trigger": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "display_name",
    "status",
    "trigger",
    "effects"
  ],
  "title": "Quête",
  "type": "object",
  "x_schema_version": "5.0.0"
}
