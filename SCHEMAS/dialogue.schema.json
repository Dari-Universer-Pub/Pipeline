{
  "$id": "https://pipeline.local/schemas/dialogue.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Schéma d'entité 'dialogue' dérivé de l'ontologie V5.",
  "properties": {
    "conditions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "display_name": {
      "description": "Nom affiché (peut contenir accents/langue du jeu).",
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "description": "Identifiant interne stable (préfixe 'dialogue_').",
      "pattern": "^dialogue_[a-z0-9_]+$",
      "type": "string"
    },
    "justification": {
      "description": "Pourquoi cet élément existe.",
      "type": "string"
    },
    "lines": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "priority": {
      "type": "integer"
    },
    "reveals": {
      "description": "Faits révélés (doivent être dans knowledge du PNJ).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source": {
      "description": "Fichier/section d'origine.",
      "type": "string"
    },
    "speaker_id": {
      "type": "string"
    },
    "status": {
      "description": "Statut de l'information.",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "speaker_id",
    "conditions",
    "lines"
  ],
  "title": "Dialogue contextuel",
  "type": "object",
  "x_schema_version": "5.0.0"
}
