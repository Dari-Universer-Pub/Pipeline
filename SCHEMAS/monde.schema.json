{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pipeline.local/schemas/monde.schema.json",
  "title": "Monde",
  "description": "Schéma d'entité 'monde' dérivé de l'ontologie V5.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^monde_[a-z0-9_]+$",
      "description": "Identifiant interne stable (préfixe 'monde_')."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom affiché (peut contenir accents/langue du jeu)."
    },
    "status": {
      "type": "string",
      "enum": [
        "CANONIQUE",
        "DEDUITE",
        "PROPOSEE",
        "A_VALIDER"
      ],
      "description": "Statut de l'information."
    },
    "source": {
      "type": "string",
      "description": "Fichier/section d'origine."
    },
    "justification": {
      "type": "string",
      "description": "Pourquoi cet élément existe."
    }
  },
  "required": [
    "id",
    "display_name",
    "status"
  ],
  "additionalProperties": true,
  "x_schema_version": "5.0.0"
}
